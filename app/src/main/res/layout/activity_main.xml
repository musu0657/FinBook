<?xml version="1.0" encoding="utf-8"?>
<!-- 记账主页面布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 写死的姓名学号 -->
    <TextView
        android:id="@+id/tv_student_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="姓名：万维唯　学号：2406100225"
        android:textSize="18sp" />

    <!-- 表单卡片：金额、备注、收支类型、分类 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 输入金额 -->
        <EditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text"
            android:hint="请输入金额"
            android:inputType="numberDecimal"
            android:paddingBottom="8dp"
            android:textColorHint="@color/btn_gray"
            android:textSize="16sp" />

        <!-- 输入备注 -->
        <EditText
            android:id="@+id/et_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edit_text"
            android:hint="添加备注"
            android:inputType="text"
            android:paddingBottom="8dp"
            android:textColorHint="@color/btn_gray"
            android:textSize="16sp" />

        <!-- 选择收支类型 -->
        <RadioGroup
            android:id="@+id/rg_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="支出" />

            <RadioButton
                android:id="@+id/rb_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收入" />
        </RadioGroup>

        <!-- 分类下拉框（列表由 MainActivity 根据收支类型动态设置） -->
        <Spinner
            android:id="@+id/sp_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- 弹簧：占据剩余空间，把按钮顶到屏幕底部 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <!-- 保存按钮（蓝色） -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="保存账单"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_blue"
            app:cornerRadius="8dp" />

        <!-- 查看列表按钮（灰色） -->
        <Button
            android:id="@+id/btn_view_list"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="查看列表"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_gray"
            app:cornerRadius="8dp" />

        <!-- 清空数据按钮（红色） -->
        <Button
            android:id="@+id/btn_clear"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="清空数据"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_red"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
